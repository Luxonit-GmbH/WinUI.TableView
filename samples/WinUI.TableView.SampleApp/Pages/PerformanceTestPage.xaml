<Page x:Class="WinUI.TableView.SampleApp.Pages.PerformanceTestPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:tv="using:WinUI.TableView"
      xmlns:controls="using:WinUI.TableView.SampleApp.Controls"
      mc:Ignorable="d"
      Loaded="OnPageLoaded"
      Unloaded="OnPageUnloaded">

    <Grid>
        <controls:SamplePresenter Header="Performance Test"
                                  Description="A blotter-shaped grid: 70 numeric columns over 1,000,000 rows, with a live feed mutating cells in the visible rows. Nothing here is a demo of a feature — it exists to be scrolled, sideways and down, while the numbers move, and to compare the grid's performance knobs on the machine that matters.">
            <controls:SamplePresenter.Example>
                <!-- Columns are generated in code: seventy of them are not worth reading in XAML. -->
                <tv:TableView x:Name="grid"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              AllowLiveShaping="False"
                              RowHeight="28"
                              IsColumnVirtualizationEnabled="True"
                              SelectionMode="Extended"
                              SelectionUnit="Cell" />
            </controls:SamplePresenter.Example>

            <controls:SamplePresenter.Options>
                <StackPanel Spacing="16"
                            MaxWidth="350">
                    <CheckBox x:Name="tickingCheckBox"
                              Content="Ticking data (live feed)"
                              IsChecked="False" />

                    <NumberBox x:Name="rateBox"
                               Header="Updates per second"
                               Value="8000"
                               Minimum="0"
                               Maximum="200000"
                               SmallChange="1000"
                               LargeChange="10000"
                               SpinButtonPlacementMode="Compact" />

                    <ToggleSwitch x:Name="virtualizationToggle"
                                  Header="Column virtualization"
                                  OnContent="On"
                                  OffContent="Off"
                                  IsOn="True" />

                    <ToggleSwitch x:Name="prefetchToggle"
                                  Header="Idle column prefetch"
                                  OnContent="On"
                                  OffContent="Off"
                                  IsOn="True" />

                    <TextBlock x:Name="statusText"
                               Style="{ThemeResource CaptionTextBlockStyle}"
                               TextWrapping="Wrap"
                               Text="Loading…" />

                    <InfoBar IsOpen="True"
                             IsClosable="False"
                             Title="How to read it"
                             Message="The feed only touches rows that are on screen, the way a real blotter's channel does. Scroll sideways with Shift+wheel or the scrollbar; the first pass over new columns is the expensive one. Flip the two switches while scrolling to feel what each buys." />
                </StackPanel>
            </controls:SamplePresenter.Options>

            <controls:SamplePresenter.Xaml>
                <x:String xml:space="preserve">
&lt;tv:TableView x:Name="grid"
              IsReadOnly="True"
              AllowLiveShaping="False"         // mutating items + live shaping is O(N) per mutation
              RowHeight="28"                   // a fixed row height keeps the cell constraint cache effective
              IsColumnVirtualizationEnabled="True"
              ColumnPrefetchLength="1" /&gt;    // create the next viewport's cells while idle

// 70 columns, generated:
for (var i = 0; i &lt; 70; i++)
    grid.Columns.Add(new TableViewNumberColumn
    {
        Header = $"C{i:D2}",
        Width = new GridLength(90),
        Binding = new Binding { Path = new PropertyPath($"C{i:D2}") },
    });

grid.ItemsSource = rows;   // 1,000,000 items, mutated in place by the feed
                </x:String>
            </controls:SamplePresenter.Xaml>
        </controls:SamplePresenter>
    </Grid>
</Page>
