<Page x:Class="WinUI.TableView.SampleApp.Pages.TreePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:local="using:WinUI.TableView.SampleApp"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:tv="using:WinUI.TableView"
      xmlns:controls="using:WinUI.TableView.SampleApp.Controls"
      mc:Ignorable="d">

    <Grid>
        <controls:SamplePresenter Header="Tree"
                                  Description="TreeTableView renders hierarchy from nested collections flattened by TreeTableViewSource. Children load lazily (simulated backend delay shows the loading ring); expansion state survives collapse.">
            <controls:SamplePresenter.Example>
                <tv:TreeTableView x:Name="treeView"
                                  AutoGenerateColumns="False"
                                  UseCollectionView="False"
                                  SelectionMode="Extended"
                                  SelectionUnit="Row">
                    <tv:TreeTableView.Columns>
                        <tv:TableViewTreeColumn x:Name="treeColumn"
                                                Header="Name"
                                                Width="320"
                                                Binding="{Binding Name}" />
                        <tv:TableViewTextColumn Header="Kind"
                                                Width="120"
                                                Binding="{Binding Kind}" />
                        <tv:TableViewNumberColumn Header="Value"
                                                  Width="120"
                                                  Binding="{Binding Value}" />
                        <tv:TableViewTextColumn Header="Items"
                                                Width="100"
                                                Binding="{Binding ChildCount}" />
                    </tv:TreeTableView.Columns>
                </tv:TreeTableView>
            </controls:SamplePresenter.Example>
            <controls:SamplePresenter.Options>
                <StackPanel Spacing="16"
                            MaxWidth="350">
                    <!-- Wired in code-behind: ElementName bindings to a column (a non-visual-tree DependencyObject)
                         do not resolve reliably. -->
                    <Slider x:Name="indentSlider"
                            Header="IndentWidth"
                            Minimum="8"
                            Maximum="48"
                            StepFrequency="4"
                            Value="16" />
                    <ToggleSwitch x:Name="slowBackendToggle"
                                  Header="Simulate slow backend (800 ms)"
                                  OnContent="On"
                                  OffContent="Off"
                                  IsOn="True" />
                    <InfoBar IsOpen="True"
                             IsClosable="False"
                             Title="Try it"
                             Message="Click a chevron (or use Left/Right arrows on a selected row) to collapse/expand. Children are fetched on first expand — the chevron shows a progress ring while the 'backend' responds. Collapse a book, expand it again: nested expansion state is preserved." />
                </StackPanel>
            </controls:SamplePresenter.Options>
            <controls:SamplePresenter.Xaml>
                <x:String xml:space="preserve">
&lt;tv:TreeTableView x:Name="treeView"
    AutoGenerateColumns="False"
    UseCollectionView="False"&gt;
    &lt;tv:TreeTableView.Columns&gt;
        &lt;tv:TableViewTreeColumn Header="Name" Width="320"
                                IndentWidth="$(IndentWidth)"
                                Binding="{Binding Name}" /&gt;
        ...
    &lt;/tv:TreeTableView.Columns&gt;
&lt;/tv:TreeTableView&gt;

// code-behind: nested collections, flattened by the library
var source = new TreeTableViewSource(roots);
treeView.ItemsSource = source;
treeView.ExpandRequested += async (_, e) =&gt;
{
    var node = (TreeItemModel)e.Item;
    if (!node.ChildrenLoaded)
    {
        node.IsLoading = true;              // chevron shows a progress ring
        await LoadChildrenAsync(node);      // your backend query
        node.IsLoading = false;
    }
    source.Expand(node);
};
treeView.CollapseRequested += (_, e) =&gt; source.Collapse((TreeItemModel)e.Item);
                </x:String>
            </controls:SamplePresenter.Xaml>
            <controls:SamplePresenter.Substitutions>
                <controls:CodeSubstitution Key="IndentWidth"
                                           Value="{x:Bind treeColumn.IndentWidth, Mode=OneWay}" />
            </controls:SamplePresenter.Substitutions>
        </controls:SamplePresenter>
    </Grid>
</Page>
