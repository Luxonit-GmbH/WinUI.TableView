<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="using:WinUI.TableView"
                    xmlns:controls="using:WinUI.TableView.Controls">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="ms-appx:///WinUI.TableView/Themes/TableView.xaml" />
        <ResourceDictionary Source="ms-appx:///WinUI.TableView/Themes/TableViewCell.xaml" />
        <ResourceDictionary Source="ms-appx:///WinUI.TableView/Themes/TableViewRowPresenter.xaml" />
        <ResourceDictionary Source="ms-appx:///WinUI.TableView/Themes/TableViewColumnHeader.xaml" />
        <ResourceDictionary Source="ms-appx:///WinUI.TableView/Themes/TableViewHeaderRow.xaml" />
        <ResourceDictionary Source="ms-appx:///WinUI.TableView/Themes/TableViewRow.xaml" />
        <ResourceDictionary Source="ms-appx:///WinUI.TableView/Themes/TableViewRowHeader.xaml" />
        <ResourceDictionary Source="ms-appx:///WinUI.TableView/Themes/TableViewTimePicker.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <!--Hack for auto generated resize issue-->
    <local:TableViewTextColumn x:Key="ThisNeedsToBeHere" />

    <Style TargetType="local:TableViewRowHeader"
           BasedOn="{StaticResource DefaultTableViewRowHeaderStyle}" />
    
    <Style BasedOn="{StaticResource DefaultTableViewRowPresenterStyle}"
           TargetType="local:TableViewRowPresenter" />

    <Style TargetType="local:TableViewHeaderRow"
           BasedOn="{StaticResource DefaultTableViewHeaderRowStyle}" />

    <Style TargetType="local:TableViewColumnHeader"
           BasedOn="{StaticResource DefaultTableViewColumnHeaderStyle}" />

    <!-- A code-only control subclass is absent from the generated XamlTypeInfo, so without an implicit style
         here XAML resolves it to its nearest native base and the style TargetType mismatch crashes at load. -->
    <Style TargetType="local:TableViewGroupHeader">
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="VerticalAlignment" Value="Stretch" />
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="local:TableViewGroupHeader">
                    <StackPanel Orientation="Horizontal"
                                Spacing="8"
                                VerticalAlignment="Center">
                        <FontIcon FontSize="12"
                                  Glyph="&#xE76C;"
                                  VerticalAlignment="Center"
                                  RenderTransformOrigin="0.5,0.5"
                                  Foreground="{ThemeResource TextFillColorSecondaryBrush}">
                            <FontIcon.RenderTransform>
                                <RotateTransform x:Name="ChevronRotation" />
                            </FontIcon.RenderTransform>
                        </FontIcon>

                        <TextBlock Text="{Binding Group.Title, RelativeSource={RelativeSource TemplatedParent}}"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center" />

                        <TextBlock Text="{Binding Group.Count, RelativeSource={RelativeSource TemplatedParent}}"
                                   VerticalAlignment="Center"
                                   Opacity="0.7"
                                   Visibility="{Binding ShowItemCount, RelativeSource={RelativeSource TemplatedParent}}" />
                    </StackPanel>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="local:TableViewColumnGroupHeader">
        <Setter Property="Background" Value="{ThemeResource TableViewColumnGroupHeaderBackground}" />
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="Padding" Value="8,0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="local:TableViewColumnGroupHeader">
                    <!-- A dedicated, themable stroke: the grid-line brush is far too faint here, so the divide
                         between one banner and the next reads as grey on grey. -->
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{ThemeResource TableViewColumnGroupHeaderStroke}"
                            BorderThickness="0,0,1,1"
                            MinHeight="{TemplateBinding MinHeight}"
                            Padding="{TemplateBinding Padding}">
                        <!-- Name and chevron travel together, centred over the run of columns. -->
                        <StackPanel Orientation="Horizontal"
                                    Spacing="6"
                                    HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                    VerticalAlignment="Center">
                            <!-- One glyph, rotated between states rather than swapped: a RenderTransform
                                 animation runs on the composition thread, so it costs no layout. -->
                            <FontIcon x:Name="CollapseChevron"
                                      FontSize="10"
                                      Glyph="&#xE76B;"
                                      VerticalAlignment="Center"
                                      RenderTransformOrigin="0.5,0.5"
                                      Foreground="{ThemeResource TextFillColorSecondaryBrush}">
                                <FontIcon.RenderTransform>
                                    <RotateTransform x:Name="ChevronRotation" />
                                </FontIcon.RenderTransform>
                            </FontIcon>
                            <ContentPresenter Content="{TemplateBinding Content}"
                                              ContentTemplate="{TemplateBinding ContentTemplate}"
                                              VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="local:TableViewCell"
           BasedOn="{StaticResource DefaultTableViewCellStyle}" />

    <Style TargetType="local:TableViewRow"
           BasedOn="{StaticResource DefaultTableViewRowStyle}" />

    <Style TargetType="local:TableView"
           BasedOn="{StaticResource DefaultTableViewStyle}" />

    <!-- Also registers TreeTableView in the generated XAML metadata; without a XAML reference the runtime cannot
         resolve the type (it falls back to ListView) and style application fails for code-created instances. -->
    <Style TargetType="local:TreeTableView"
           BasedOn="{StaticResource DefaultTableViewStyle}" />

    <Style TargetType="controls:TableViewTimePicker"
           BasedOn="{StaticResource DefaultTableViewTimePickerStyle}" />

</ResourceDictionary>
